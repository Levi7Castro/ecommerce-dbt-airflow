# Modelo de configuração. Copie para .env e preencha com os seus valores:
#   cp .env.example .env
# O .env está no .gitignore e nunca deve ir para o repositório.

# UID do seu usuário (consulte com: id -u)
AIRFLOW_UID=1000

# Banco de metadados do Airflow (container postgres do Compose).
# Se a senha tiver caracteres especiais (@ : / #), use a versão codificada para URL.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=troque_aqui

# Chave JWT compartilhada entre scheduler e api-server. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AIRFLOW_JWT_SECRET=troque_por_uma_chave_aleatoria

# Conexão do dbt com o data warehouse (PostgreSQL).
# Se o DW roda no WSL e os containers no Docker Desktop, use o IP do WSL:
#   hostname -I | awk '{print $1}'
# (host.docker.internal aponta para o Windows no Docker Desktop, não para o WSL)
DBT_HOST=seu_host
DBT_PORT=5432
DBT_USER=seu_usuario
DBT_PASSWORD=troque_aqui
DBT_DBNAME=dw
